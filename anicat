#!/usr/bin/env bash
# shellcheck shell=bash
#
# anicat - batch downloader for ani-cli that files everything into folders.
#
# You pick one or more anime entries (each season is its own entry) in a single
# fzf screen; anicat downloads every episode of each one through ani-cli and then
# sorts the files into a sane library layout:
#
#     Anime/
#       Jujutsu Kaisen/
#         Season 01/Jujutsu Kaisen - S01E01.mp4
#         Season 02/Jujutsu Kaisen 2nd Season - S02E01.mp4
#       Movies/
#         Jujutsu Kaisen 0 Movie/Jujutsu Kaisen 0 Movie.mp4
#
# ani-cli is treated as the download engine (it resolves the stream links). We
# only re-implement its two tiny scraping calls so we can show a multi-select
# menu and know the exact entry titles ahead of time.
#
# License: MIT

set -u -o pipefail

ANICAT_VERSION="1.0.0"
HIANIME_BASE="${HIANIME_BASE:-https://hianime.at}"
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# ---------------------------------------------------------------------------
# Configuration (flags override environment, environment overrides defaults)
# ---------------------------------------------------------------------------

DESTINATION_DIR="${ANICAT_DEST:-$HOME/Anime}"
VIDEO_QUALITY="${ANICAT_QUALITY:-best}"
RELEASE_MODE="${ANICAT_MODE:-sub}"          # sub | dub
EPISODE_SELECTION="${ANICAT_EPISODES:-all}" # all | pick | <range like 1-12>
ANI_CLI_PATH="${ANICAT_ANI_CLI:-}"
ANI_CLI_HOME="${ANICAT_HOME:-$HOME/.local/share/anicat}"
INSTALL_BIN_DIR="${ANICAT_BIN_DIR:-$HOME/.local/bin}"
ALLOW_ANI_CLI_INSTALL=1
SEARCH_TERM=""
FORCE_OVERWRITE=0

STAGING_ROOT=""
ANI_CLI=""

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    COLOR_INFO=$'\033[1;34m'
    COLOR_WARN=$'\033[1;33m'
    COLOR_ERROR=$'\033[1;31m'
    COLOR_TITLE=$'\033[1;36m'
    COLOR_RESET=$'\033[0m'
else
    COLOR_INFO=""
    COLOR_WARN=""
    COLOR_ERROR=""
    COLOR_TITLE=""
    COLOR_RESET=""
fi

log_info() { printf '%s%s%s\n' "$COLOR_INFO" "$*" "$COLOR_RESET" >&2; }
log_warn() { printf '%s%s%s\n' "$COLOR_WARN" "$*" "$COLOR_RESET" >&2; }
log_error() { printf '%s%s%s\n' "$COLOR_ERROR" "$*" "$COLOR_RESET" >&2; }
log_title() { printf '%s%s%s\n' "$COLOR_TITLE" "$*" "$COLOR_RESET" >&2; }
die() {
    log_error "$*"
    exit 1
}

print_help() {
    cat <<EOF
anicat $ANICAT_VERSION - batch download anime into organized folders (uses ani-cli)

Usage:
  anicat [options] [search term]

Options:
  -d, --dest DIR       Library root (default: \$HOME/Anime)
  -q, --quality Q      Video quality, e.g. best, 1080p, 720p (default: best)
      --dub            Prefer the dubbed audio track
      --sub            Prefer the subbed audio track (default)
  -a, --all            Download every episode of the chosen entries (default)
  -p, --pick           Choose episodes interactively per entry
  -e, --episodes R    Download an explicit range, e.g. 1-12 or 5
      --force          Overwrite files that already exist in the library
      --no-install     Never auto-install ani-cli; fail instead if missing
      --install        Install this script into $INSTALL_BIN_DIR
  -V, --version        Print the version and exit
  -h, --help           Show this help and exit

Environment overrides:
  ANICAT_DEST, ANICAT_QUALITY, ANICAT_MODE, ANICAT_EPISODES,
  ANICAT_ANI_CLI, ANICAT_HOME, ANICAT_BIN_DIR, HIANIME_BASE

Examples:
  anicat                       # interactive search, pick entries, grab all episodes
  anicat "frieren" -q 1080p    # search frieren at 1080p
  anicat --dub -p "one piece"  # dub, pick specific episodes by hand
  ANICAT_DEST=/media/tv anicat "vinland saga"
EOF
}

# ---------------------------------------------------------------------------
# Small interactive / filesystem helpers
# ---------------------------------------------------------------------------

# Read a single line straight from the terminal so it never eats piped input.
prompt_line() {
    local prompt_text="$1"
    local default_value="${2:-}"
    local answer=""
    if [ -r /dev/tty ]; then
        read -r -p "$prompt_text" answer </dev/tty || answer=""
    else
        read -r -p "$prompt_text" answer || answer=""
    fi
    if [ -z "$answer" ]; then
        answer="$default_value"
    fi
    printf '%s' "$answer"
}

# Turn a title into a safe single path component (keeps it recognizable).
sanitize_path_component() {
    local raw_name="$1"
    local cleaned_name
    cleaned_name="$(printf '%s' "$raw_name" | tr '/' '_')"
    cleaned_name="$(printf '%s' "$cleaned_name" | sed -E 's/^[[:space:].]+//; s/[[:space:].]+$//')"
    printf '%s' "$cleaned_name"
}

require_command() {
    local command_name="$1"
    local install_hint="$2"
    if ! command -v "$command_name" >/dev/null 2>&1; then
        die "Required command '$command_name' not found. $install_hint"
    fi
}

cleanup_staging() {
    if [ -n "$STAGING_ROOT" ] && [ -d "$STAGING_ROOT" ]; then
        rm -rf "$STAGING_ROOT"
    fi
}

# ---------------------------------------------------------------------------
# ani-cli discovery and installation
# ---------------------------------------------------------------------------

install_ani_cli() {
    local install_target="$ANI_CLI_HOME/ani-cli"
    mkdir -p "$ANI_CLI_HOME"
    log_info "Installing ani-cli into $install_target ..."
    if ! curl -fsSL -A "$USER_AGENT" --max-time 60 \
        "https://raw.githubusercontent.com/pystardust/ani-cli/master/ani-cli" \
        -o "$install_target"; then
        rm -f "$install_target"
        return 1
    fi
    # Guard against HTML error pages being saved as the script.
    if ! grep -q '^version_number=' "$install_target"; then
        rm -f "$install_target"
        return 1
    fi
    chmod +x "$install_target"
    log_info "ani-cli installed."
    return 0
}

resolve_ani_cli() {
    if [ -n "$ANI_CLI_PATH" ]; then
        [ -x "$ANI_CLI_PATH" ] || die "ANI_CLI/--(ani-cli path) '$ANI_CLI_PATH' is not executable."
        printf '%s' "$ANI_CLI_PATH"
        return 0
    fi
    if command -v ani-cli >/dev/null 2>&1; then
        command -v ani-cli
        return 0
    fi
    local bundled_path="$ANI_CLI_HOME/ani-cli"
    if [ -x "$bundled_path" ]; then
        printf '%s' "$bundled_path"
        return 0
    fi
    if [ "$ALLOW_ANI_CLI_INSTALL" != "1" ]; then
        die "ani-cli not found and auto-install is disabled. Install it or set ANICAT_ANI_CLI."
    fi
    if ! install_ani_cli; then
        die "Could not install ani-cli. Install it manually: https://github.com/pystardust/ani-cli"
    fi
    printf '%s' "$bundled_path"
}

# ---------------------------------------------------------------------------
# Scraping (mirrors ani-cli's parsing so entry titles and episode numbers match)
# ---------------------------------------------------------------------------

# Search hianime and print "entry_id<TAB>entry_title" lines.
search_entries() {
    local keyword="$1"
    local page_html
    page_html="$(curl -sL -A "$USER_AGENT" --max-time 20 "$HIANIME_BASE/search?keyword=$keyword")" || return 1
    if [ -z "$page_html" ]; then
        return 1
    fi
    if printf '%s' "$page_html" | grep -qi 'Just a moment'; then
        log_error "hianime.at challenged the request (Cloudflare). Retry, or install curl-impersonate."
        return 1
    fi
    printf '%s' "$page_html" \
        | sed '/id="main-sidebar"/,$d' \
        | tr '\n' ' ' \
        | sed 's|<div class="film-detail">|\n<div class="film-detail">|g' \
        | sed -nE 's|.*<h3 class="film-name">[[:space:]]*<a href="[^"]*/([^"/]*)"[[:space:]]*title="([^"]*)".*|\1\t\2|p' \
        | sed -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e 's|&amp;|\&|g'
}

# Print each episode number of an entry, one per line.
list_episode_numbers() {
    local entry_id="$1"
    local page_html
    page_html="$(curl -sL -A "$USER_AGENT" --max-time 20 "$HIANIME_BASE/api/theme/episode/list/${entry_id##*-}")" || return 1
    [ -n "$page_html" ] || return 1
    printf '%s' "$page_html" \
        | sed 's|\\||g; s|ep-item|\nep-item|g' \
        | sed -nE "s|.*data-number=\"([^\"]*)\".*data-id=\"([0-9]+)\".*/watch/${entry_id}[?]ep=.*|\2\t\1|p" \
        | cut -f 2
}

# ---------------------------------------------------------------------------
# Title parsing: derive a series name and a season number from an entry title
# ---------------------------------------------------------------------------

# Sets SERIES_NAME, SEASON_NUMBER and IS_MOVIE for the given entry title.
parse_entry_title() {
    local entry_title="$1"
    SERIES_NAME="$entry_title"
    SEASON_NUMBER=1
    IS_MOVIE=0

    if printf '%s' "$entry_title" | grep -qiE '(^|[^[:alnum:]])movie([^[:alnum:]]|$)'; then
        IS_MOVIE=1
        return 0
    fi

    # "Jujutsu Kaisen 2nd Season" / "Bleach 3rd Season: Subtitle"
    local ordinal_season_pattern='^(.*[^[:space:]])[[:space:]]+([0-9]+)(st|nd|rd|th)[[:space:]]+[Ss]eason'
    # "Attack on Titan Season 3"
    local numbered_season_pattern='^(.*[^[:space:]])[[:space:]]+[Ss]eason[[:space:]]+([0-9]+)'
    # "Overlord IV"
    local roman_season_pattern='^(.*[^[:space:]])[[:space:]]+(II|III|IV|V|VI|VII|VIII|IX|X)$'
    # "My Hero Academia 4" (bare trailing season number, no "Season" word)
    local trailing_number_pattern='^(.*[^[:space:][:digit:]])[[:space:]]+([0-9]{1,2})$'

    if [[ "$entry_title" =~ $ordinal_season_pattern ]]; then
        SERIES_NAME="${BASH_REMATCH[1]}"
        SEASON_NUMBER="${BASH_REMATCH[2]}"
    elif [[ "$entry_title" =~ $numbered_season_pattern ]]; then
        SERIES_NAME="${BASH_REMATCH[1]}"
        SEASON_NUMBER="${BASH_REMATCH[2]}"
    elif [[ "$entry_title" =~ $roman_season_pattern ]]; then
        SERIES_NAME="${BASH_REMATCH[1]}"
        SEASON_NUMBER="$(roman_to_number "${BASH_REMATCH[2]}")"
    elif [[ "$entry_title" =~ $trailing_number_pattern ]]; then
        # Only a plausible season number, and never "Part 2"-style continuations
        # or titles that are just a number ("86").
        local trailing_number="${BASH_REMATCH[2]}"
        local base_name="${BASH_REMATCH[1]}"
        if [ "$((10#$trailing_number))" -ge 2 ] && [ "$((10#$trailing_number))" -le 30 ] \
            && ! [[ "$base_name" =~ (Part|Cour|Chapter|Season)$ ]]; then
            SERIES_NAME="$base_name"
            SEASON_NUMBER="$((10#$trailing_number))"
        fi
    fi

    # Drop trailing separators left behind by removing the season marker.
    # Two narrow classes rather than one: a hyphen between other members would be
    # read as a character range and eat the last letter of the series name.
    SERIES_NAME="$(printf '%s' "$SERIES_NAME" | sed -E 's/[[:space:]]*[:-][[:space:]]*$//; s/[[:space:]]*[–—][[:space:]]*$//; s/[[:space:]]+$//')"
    if [ -z "$SERIES_NAME" ]; then
        SERIES_NAME="$entry_title"
    fi
    if ! [[ "$SEASON_NUMBER" =~ ^[0-9]+$ ]]; then
        SEASON_NUMBER=1
    fi
    return 0
}

roman_to_number() {
    case "$1" in
        II) printf '2' ;;
        III) printf '3' ;;
        IV) printf '4' ;;
        V) printf '5' ;;
        VI) printf '6' ;;
        VII) printf '7' ;;
        VIII) printf '8' ;;
        IX) printf '9' ;;
        X) printf '10' ;;
        *) printf '1' ;;
    esac
}

# Zero-pad an episode number, keeping any fractional part ("1" -> "01", "1.5" -> "01.5").
format_episode_label() {
    local episode_number="$1"
    if [[ "$episode_number" =~ ^([0-9]+)(.*)$ ]]; then
        printf '%02d%s' "$((10#${BASH_REMATCH[1]}))" "${BASH_REMATCH[2]}"
    else
        printf '%s' "$episode_number"
    fi
}

# ---------------------------------------------------------------------------
# Selection UI
# ---------------------------------------------------------------------------

# stdin: "index<TAB>id<TAB>title" lines -> stdout: the chosen lines
select_entries_interactively() {
    fzf --reverse --cycle --multi \
        --delimiter=$'\t' --with-nth=3 \
        --prompt='Select anime (TAB multi-select, Ctrl-A all) > ' \
        --header='Each season is a separate entry. ENTER to confirm.'
}

# ---------------------------------------------------------------------------
# Download + organize
# ---------------------------------------------------------------------------

# Move staged files into the library layout and rename them consistently.
organize_downloads() {
    local entry_title="$1"
    local staging_dir="$2"

    if [ ! -d "$staging_dir" ]; then
        return 0
    fi

    local safe_title
    safe_title="$(printf '%s' "$entry_title" | tr '<>:"/\\|?*' '_')"
    local file_prefix="${safe_title} Episode "

    parse_entry_title "$entry_title"
    local series_component
    series_component="$(sanitize_path_component "$SERIES_NAME")"

    local target_dir
    if [ "$IS_MOVIE" -eq 1 ]; then
        target_dir="$DESTINATION_DIR/Movies/$(sanitize_path_component "$entry_title")"
    else
        local season_component
        season_component="$(printf 'Season %02d' "$SEASON_NUMBER")"
        target_dir="$DESTINATION_DIR/$series_component/$season_component"
    fi
    mkdir -p "$target_dir"

    local moved_count=0
    local staged_file
    for staged_file in "$staging_dir"/*; do
        [ -e "$staged_file" ] || continue
        local file_name file_extension
        file_name="$(basename "$staged_file")"
        file_extension="${file_name##*.}"

        local destination_name="$file_name"
        if [[ "$file_name" == "$file_prefix"* ]]; then
            local episode_token="${file_name#"$file_prefix"}"
            episode_token="${episode_token%.*}"
            if [ "$IS_MOVIE" -eq 1 ]; then
                destination_name="$(sanitize_path_component "$entry_title").${file_extension}"
            else
                destination_name="${series_component} - S$(printf '%02d' "$SEASON_NUMBER")E$(format_episode_label "$episode_token").${file_extension}"
            fi
        fi

        local destination_path="$target_dir/$destination_name"
        if [ -e "$destination_path" ] && [ "$FORCE_OVERWRITE" != "1" ]; then
            log_warn "Already present, skipping: $destination_name"
            rm -f "$staged_file"
            continue
        fi

        mv -f "$staged_file" "$destination_path"
        moved_count=$((moved_count + 1))
    done

    if [ "$moved_count" -eq 0 ]; then
        log_warn "Nothing was downloaded for \"$entry_title\"."
    else
        log_info "Filed $moved_count file(s) into $target_dir"
    fi
}

# Download a single entry by its position in the search list, then organize it.
download_entry() {
    local entry_index="$1"
    local search_query="$2"
    local entry_id="$3"
    local entry_title="$4"

    log_title "==> $entry_title"
    local staging_dir="$STAGING_ROOT/$entry_index"
    rm -rf "$staging_dir"
    mkdir -p "$staging_dir"

    local ani_cli_arguments=(-d -q "$VIDEO_QUALITY" -S "$entry_index")
    if [ "$RELEASE_MODE" = "dub" ]; then
        ani_cli_arguments+=(--dub)
    fi

    case "$EPISODE_SELECTION" in
        pick)
            : # Let ani-cli show its episode menu.
            ;;
        all)
            local episode_numbers
            episode_numbers="$(list_episode_numbers "$entry_id")"
            local first_episode last_episode episode_count
            first_episode="$(printf '%s\n' "$episode_numbers" | head -n 1)"
            last_episode="$(printf '%s\n' "$episode_numbers" | tail -n 1)"
            episode_count="$(printf '%s\n' "$episode_numbers" | grep -c .)"
            if [ -n "$first_episode" ] && [ -n "$last_episode" ]; then
                log_info "$episode_count episode(s) found: $first_episode-$last_episode"
                ani_cli_arguments+=(-e "$first_episode-$last_episode")
            else
                log_warn "Could not read the episode list; ani-cli will ask instead."
            fi
            ;;
        *)
            ani_cli_arguments+=(-e "$EPISODE_SELECTION")
            ;;
    esac

    if ! ANI_CLI_DOWNLOAD_DIR="$staging_dir" "$ANI_CLI" "${ani_cli_arguments[@]}" "$search_query"; then
        log_error "ani-cli reported a failure for \"$entry_title\"."
    fi

    organize_downloads "$entry_title" "$staging_dir"
}

# ---------------------------------------------------------------------------
# Self installation
# ---------------------------------------------------------------------------

install_self() {
    local script_source="${BASH_SOURCE[0]}"
    mkdir -p "$INSTALL_BIN_DIR"
    local install_target="$INSTALL_BIN_DIR/anicat"
    cp "$script_source" "$install_target"
    chmod +x "$install_target"
    log_info "Installed anicat to $install_target"
    case ":$PATH:" in
        *":$INSTALL_BIN_DIR:"*) ;;
        *)
            log_warn "$INSTALL_BIN_DIR is not on your PATH. Add this to your shell profile:"
            log_warn "  export PATH=\"$INSTALL_BIN_DIR:\$PATH\""
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

parse_arguments() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -d | --dest)
                [ $# -ge 2 ] || die "Missing value for $1"
                DESTINATION_DIR="$2"
                shift 2
                ;;
            -q | --quality)
                [ $# -ge 2 ] || die "Missing value for $1"
                VIDEO_QUALITY="$2"
                shift 2
                ;;
            -e | --episodes)
                [ $# -ge 2 ] || die "Missing value for $1"
                EPISODE_SELECTION="$2"
                shift 2
                ;;
            --dub)
                RELEASE_MODE="dub"
                shift
                ;;
            --sub)
                RELEASE_MODE="sub"
                shift
                ;;
            -a | --all)
                EPISODE_SELECTION="all"
                shift
                ;;
            -p | --pick)
                EPISODE_SELECTION="pick"
                shift
                ;;
            --force)
                FORCE_OVERWRITE=1
                shift
                ;;
            --no-install)
                ALLOW_ANI_CLI_INSTALL=0
                shift
                ;;
            --install)
                install_self
                exit 0
                ;;
            -V | --version)
                printf 'anicat %s\n' "$ANICAT_VERSION"
                exit 0
                ;;
            -h | --help)
                print_help
                exit 0
                ;;
            --)
                shift
                while [ $# -gt 0 ]; do
                    SEARCH_TERM="$SEARCH_TERM $1"
                    shift
                done
                ;;
            -*)
                die "Unknown option: $1 (try --help)"
                ;;
            *)
                SEARCH_TERM="$SEARCH_TERM $1"
                shift
                ;;
        esac
    done
    SEARCH_TERM="${SEARCH_TERM# }"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

check_environment() {
    require_command curl "Install curl."
    require_command sed "Install sed."
    require_command grep "Install grep."
    require_command awk "Install awk."
    require_command fzf "Install fzf (used for the selection menu)."
    if ! command -v yt-dlp >/dev/null 2>&1 && ! command -v ffmpeg >/dev/null 2>&1; then
        die "Neither yt-dlp nor ffmpeg found. ani-cli needs one of them to download."
    fi
}

run_one_batch() {
    local search_term="$1"
    local keyword
    keyword="$(printf '%s' "$search_term" | sed 's| |+|g')"

    log_info "Searching \"$search_term\" ..."
    local entry_list
    if ! entry_list="$(search_entries "$keyword")"; then
        log_error "Search request failed."
        return 1
    fi
    if [ -z "$entry_list" ]; then
        log_warn "No results for \"$search_term\"."
        return 1
    fi

    local numbered_list
    numbered_list="$(printf '%s\n' "$entry_list" | awk -F'\t' '{printf "%d\t%s\t%s\n", NR, $1, $2}')"

    local selected_entries
    selected_entries="$(printf '%s\n' "$numbered_list" | select_entries_interactively)" || true
    if [ -z "$selected_entries" ]; then
        log_warn "Nothing selected."
        return 0
    fi

    # ani-cli's -S index is the 1-based position in this same search list.
    local entry_index entry_id entry_title
    while IFS=$'\t' read -r entry_index entry_id entry_title; do
        [ -n "$entry_index" ] || continue
        download_entry "$entry_index" "$search_term" "$entry_id" "$entry_title"
    done <<<"$selected_entries"
    return 0
}

main() {
    parse_arguments "$@"
    check_environment

    ANI_CLI="$(resolve_ani_cli)"
    log_info "Using ani-cli: $ANI_CLI"

    mkdir -p "$DESTINATION_DIR"
    STAGING_ROOT="$DESTINATION_DIR/.anicat-staging.$$"
    rm -rf "$STAGING_ROOT"
    mkdir -p "$STAGING_ROOT"
    trap 'cleanup_staging' EXIT
    trap 'cleanup_staging; exit 130' INT TERM HUP

    local first_search_term="$SEARCH_TERM"
    if [ -z "$first_search_term" ]; then
        first_search_term="$(prompt_line 'Search anime: ')"
    fi
    if [ -z "$first_search_term" ]; then
        die "No search term given."
    fi

    local search_term="$first_search_term"
    while :; do
        run_one_batch "$search_term" || log_warn "That search turned up nothing usable."
        local another
        another="$(prompt_line 'Search for more anime? [y/N] ' 'n')"
        case "$another" in
            [yY]*) search_term="$(prompt_line 'Search anime: ')" ;;
            *) break ;;
        esac
        if [ -z "$search_term" ]; then
            break
        fi
    done

    log_info "All done. Library: $DESTINATION_DIR"
}

# Run only when executed directly, so the functions stay testable when sourced.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
